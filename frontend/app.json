{
  "expo": {
    "name": "My Cluster",
    "slug": "my-cluster",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mycluster",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emergent.sentinelaudit.chvfyq",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Compartir tu ubicación con tu grupo",
        "NSCameraUsageDescription": "Grabar incidencias de la vía voluntariamente",
        "NSMicrophoneUsageDescription": "Registrar incidencias por voz",
        "NSPhotoLibraryUsageDescription": "Elegir tu foto de perfil para el mapa",
        "NSContactsUsageDescription": "Elegir a quién invitar a tu grupo"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#060B16"
      },
      "package": "com.emergent.sentinelaudit.chvfyq",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "CAMERA",
        "RECORD_AUDIO",
        "READ_CONTACTS",
        "READ_MEDIA_IMAGES"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#060B16"
        }
      ],
      "expo-font",
      "expo-image",
      "expo-secure-store",
      "expo-web-browser",
      "expo-status-bar",
      "@react-native-vector-icons/ionicons",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Compartir tu ubicación con tu grupo"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
